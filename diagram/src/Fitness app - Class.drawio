        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\nskinparam classAttributeIconSize 0\nskinparam nodesep 14\nskinparam ranksep 24\nskinparam padding 2\nskinparam defaultFontSize 11\nskinparam class {\n  BorderColor #333333\n  ArrowColor #444444\n}\n\n&#39; === CONTROLLERS (ORANGE) ===\nclass AuthProfileController #FFF3E0 {\n  + Register(dto)\n  + Login(dto)\n  + UpdateProfile(dto)\n  + LogWeight(weight)\n}\n\nclass WorkoutController #FFF3E0 {\n  + GenerateProgram(goal)\n  + TrackSession(dto)\n  + SetReminder(cron)\n}\n\nclass ReportAdminController #FFF3E0 {\n  + GetProgressChart()\n  + GetPopularWorkouts()\n  + GetAvgActivity(period)\n  + ManageCatalog(dto)\n}\n\n&#39; === GOF PATTERNS (GREEN) ===\nclass ProgramDirector #E8F5E9 {\n  - _builder : IProgramBuilder\n  + Construct(profile) : UserProgram\n}\n\nclass StandardProgramBuilder #E8F5E9 {\n  + SetGoal(goal)\n  + AddWarmup()\n  + AddWorkouts()\n  + Build() : UserProgram\n}\n\ninterface ICalorieStrategy &lt;&lt;interface&gt;&gt; #E8F5E9 {\n  + Calculate(weight, mins, met) : double\n}\nclass CardioStrategy #E8F5E9 {\n  + Calculate(...) : double\n}\nclass StrengthStrategy #E8F5E9 {\n  + Calculate(...) : double\n}\nclass YogaStrategy #E8F5E9 {\n  + Calculate(...) : double\n}\n\nclass WorkoutEventPublisher #E8F5E9 {\n  - _observers : List&lt;IWorkoutObserver&gt;\n  + NotifyCompleted(session)\n}\ninterface IWorkoutObserver &lt;&lt;interface&gt;&gt; #E8F5E9 {\n  + OnCompleted(session)\n}\nclass AchievementObserver #E8F5E9 {\n  + OnCompleted(session)\n}\nclass ChallengeObserver #E8F5E9 {\n  + OnCompleted(session)\n}\n\ninterface IReportService &lt;&lt;interface&gt;&gt; #E8F5E9 {\n  + GetUserProgress(userId)\n  + GetPopularWorkouts()\n  + GetAvgActivity(from, to)\n}\nclass BaseReportService #E8F5E9 {\n  + GetUserProgress(userId)\n  + GetPopularWorkouts()\n  + GetAvgActivity(from, to)\n}\nclass CachedReportDecorator #E8F5E9 {\n  - _inner : IReportService\n  + GetPopularWorkouts()\n}\n\n&#39; === DOMAIN ENTITIES (BLUE) ===\nclass User #E3F2FD {\n  + Id : Guid\n  + Email : string\n  + PasswordHash : string\n  + Role : UserRole\n}\n\nclass UserProfile #E3F2FD {\n  + UserId : Guid\n  + Gender : Gender\n  + BirthDate : DateOnly\n  + HeightCm : double\n  + WeightKg : double\n  + CalculateBMI() : double\n}\n\nclass WeightLog #E3F2FD {\n  + Id : Guid\n  + UserId : Guid\n  + WeightKg : double\n  + RecordedAt : DateTime\n}\n\nclass Reminder #E3F2FD {\n  + Id : Guid\n  + UserId : Guid\n  + Cron : string\n  + Channel : NotifyChannel\n}\n\nclass UserProgram #E3F2FD {\n  + Id : Guid\n  + UserId : Guid\n  + Title : string\n  + Goal : FitnessGoal\n}\n\nclass WorkoutSession #E3F2FD {\n  + Id : Guid\n  + UserId : Guid\n  + TemplateId : Guid\n  + DurationMins : int\n  + CaloriesBurned : double\n}\n\nclass WorkoutTemplate #E3F2FD {\n  + Id : Guid\n  + Title : string\n  + Type : WorkoutType\n  + Difficulty : Level\n}\n\nclass WorkoutExercise #E3F2FD {\n  + TemplateId : Guid\n  + ExerciseId : Guid\n  + Sets : int\n  + Reps : int\n  + OrderIndex : int\n}\n\nclass Exercise #E3F2FD {\n  + Id : Guid\n  + Name : string\n  + Category : WorkoutType\n  + BaseMet : double\n}\n\nclass Achievement #E3F2FD {\n  + Id : Guid\n  + Title : string\n  + Threshold : int\n}\n\nclass Challenge #E3F2FD {\n  + Id : Guid\n  + Title : string\n  + TargetCalories : double\n  + EndDate : DateTime\n}\n\n&#39; === CONNECTIONS ===\nAuthProfileController --&gt; User\nWorkoutController --&gt; ProgramDirector\nWorkoutController --&gt; ICalorieStrategy\nWorkoutController --&gt; WorkoutEventPublisher\nReportAdminController --&gt; IReportService\n\nProgramDirector o--&gt; StandardProgramBuilder\nStandardProgramBuilder ..&gt; UserProgram\n\nICalorieStrategy &lt;|.. CardioStrategy\nICalorieStrategy &lt;|.. StrengthStrategy\nICalorieStrategy &lt;|.. YogaStrategy\n\nWorkoutEventPublisher o--&gt; IWorkoutObserver\nIWorkoutObserver &lt;|.. AchievementObserver\nIWorkoutObserver &lt;|.. ChallengeObserver\nAchievementObserver ..&gt; Achievement\nChallengeObserver ..&gt; Challenge\n\nIReportService &lt;|.. BaseReportService\nIReportService &lt;|.. CachedReportDecorator\nCachedReportDecorator o--&gt; IReportService\n\nUser \&quot;1\&quot; *-- \&quot;1\&quot; UserProfile\nUser \&quot;1\&quot; o-- \&quot;*\&quot; WeightLog\nUser \&quot;1\&quot; o-- \&quot;*\&quot; Reminder\nUser \&quot;1\&quot; o-- \&quot;*\&quot; UserProgram\nUser \&quot;1\&quot; o-- \&quot;*\&quot; WorkoutSession\nUser \&quot;*\&quot; -- \&quot;*\&quot; Achievement\nUser \&quot;*\&quot; -- \&quot;*\&quot; Challenge\n\nUserProgram \&quot;*\&quot; o-- \&quot;*\&quot; WorkoutTemplate\nWorkoutSession \&quot;*\&quot; --&gt; \&quot;1\&quot; WorkoutTemplate\nWorkoutTemplate \&quot;1\&quot; *-- \&quot;*\&quot; WorkoutExercise\nExercise \&quot;1\&quot; -- \&quot;*\&quot; WorkoutExercise\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="aYr7OE0WLAieCm7hDhID-716">
